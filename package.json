{
  "name": "winterminal-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that drives the real Windows Terminal application (wt.exe) via UI Automation — open tabs, type commands, read what's on screen, and send real Ctrl+C, scoped to a single pane instead of the whole machine.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "winterminal-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "mcp",
    "windows-terminal",
    "wt",
    "automation",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
